import Foundation

// MARK: - AppEnvironment

/// Represents the application environment.
/// The current environment is determined at runtime from the Info.plist configuration.
enum AppEnvironment: String, CaseIterable {
{{ range .Schemes }}    case {{ lower . }}
{{ end }}
    // MARK: - Current Environment

    static var current: AppEnvironment {
        guard let environmentString = Bundle.main.infoDictionary?["APP_ENVIRONMENT"] as? String,
              let environment = AppEnvironment(rawValue: environmentString) else {
            #if DEBUG
            {{ if .Schemes }}return .{{ lower (index .Schemes 0) }}{{ end }}
            #else
            {{ if .Schemes }}return .{{ lower (last .Schemes) }}{{ end }}
            #endif
        }
        return environment
    }

    // MARK: - Convenience Properties
{{ range .Schemes }}
    var is{{ pascal . }}: Bool {
        self == .{{ lower . }}
    }
{{ end }}
    var isDebugBuild: Bool {
        #if DEBUG
        return true
        #else
        return false
        #endif
    }

    // MARK: - Display

    var displayName: String {
        switch self {
{{ range .Schemes }}        case .{{ lower . }}: "{{ pascal . }}"
{{ end }}        }
    }
}
