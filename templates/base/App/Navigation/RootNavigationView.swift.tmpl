import SwiftUI

// MARK: - RootNavigationView

/// Root view that manages the NavigationStack and state persistence.
/// Navigation logic is delegated to AppNavigationCoordinator.
struct RootNavigationView: View {
    // MARK: - Properties

    /// Concrete type required: SwiftUI @Bindable does not support protocol types.
    /// Injection is performed via init using the concrete type; the AppRouter protocol
    /// is used at call sites in ViewModel dependencies.
    @Bindable
    var appRouter: AppRouterImpl
    let dependencies: AppDependencies

    @State
    private var coordinator: AppNavigationCoordinator

    @SceneStorage("app.navigation.path")
    private var navigationData: Data?

    // MARK: - Init

    init(appRouter: AppRouterImpl, dependencies: AppDependencies) {
        self.appRouter = appRouter
        self.dependencies = dependencies
        self._coordinator = State(initialValue: AppNavigationCoordinator(appRouter: appRouter))
    }

    // MARK: - Body

    var body: some View {
        NavigationStack(path: $appRouter.path) {
            Text(String(localized: "root.placeholder.title"))
{{- if .IncludeExample }}
                .withExampleRoutes(appRouter: appRouter, dependencies: dependencies)
{{- end }}
        }
        .onOpenURL { url in
            coordinator.handleDeepLink(url)
        }
        .task(id: "restore") {
            coordinator.restoreNavigationState(from: navigationData)
        }
        .onChange(of: appRouter.path) { _, _ in
            coordinator.saveNavigationStateDebounced { data in
                navigationData = data
            }
        }
    }
}
