import Foundation
import os
import SwiftUI

// MARK: - AppNavigationCoordinator

/// Coordinates navigation logic: deep link parsing, state persistence, and debounced saves.
/// Deep links received before the saved state is restored (for example, the URL that launched
/// the app) are held and applied right after restoration, so they win regardless of whether
/// `.onOpenURL` or the restoration `.task` runs first. To navigate from a deep link, build a
/// `NavigationPath` in `navigate(to:)` and assign it to `appRouter.path` to replace the stack.
@MainActor
@Observable
final class AppNavigationCoordinator {
    // MARK: - Static

    private nonisolated static let logger = Logger(
        subsystem: Bundle.main.bundleIdentifier ?? "{{ .BundleID }}",
        category: "Navigation"
    )

    // MARK: - Properties

    private let appRouter: AppRouterImpl
    private var saveTask: Task<Void, Never>?
    private var hasRestoredState = false
    private var pendingDeepLink: URL?

    // MARK: - Init

    init(appRouter: AppRouterImpl) {
        self.appRouter = appRouter
    }

    // MARK: - Deep Linking

    /// Handles a deep link. Before restoration it is held until `restoreNavigationState(from:)` runs;
    /// a newer link replaces a held one.
    func handleDeepLink(_ url: URL) {
        guard hasRestoredState else {
            pendingDeepLink = url
            return
        }
        navigate(to: url)
    }

    // MARK: - State Persistence

    /// Restores navigation state from previously persisted data, once, and then applies any
    /// deep link received before restoration.
    /// Failure is non-critical: an empty NavigationPath is used as fallback so the app
    /// always starts in a valid state even when stored data is corrupt or incompatible.
    func restoreNavigationState(from data: Data?) {
        guard !hasRestoredState else { return }

        if let data {
            restorePath(from: data)
        }
        hasRestoredState = true

        if let pendingDeepLink {
            self.pendingDeepLink = nil
            navigate(to: pendingDeepLink)
        }
    }

    /// Encodes the current navigation path for persistence.
    /// Returns nil on failure — the caller treats nil as "do not persist",
    /// which is the safe fallback when the path contains non-codable routes.
    func encodeNavigationState() -> Data? {
        guard let codableRep = appRouter.path.codable else { return nil }

        do {
            return try JSONEncoder().encode(codableRep)
        } catch {
            Self.logger.error("Failed to save navigation state: \(error.localizedDescription, privacy: .public)")
            return nil
        }
    }

    /// Debounces navigation state saves. When encoding fails nothing is written,
    /// so the last good state is kept.
    func saveNavigationStateDebounced(persist: @escaping @MainActor (Data) -> Void) {
        saveTask?.cancel()
        saveTask = Task { [weak self] in
            do {
                try await Task.sleep(for: .milliseconds(300))
            } catch {
                return
            }
            guard !Task.isCancelled, let data = self?.encodeNavigationState() else { return }
            persist(data)
        }
    }
}

// MARK: - Private Methods

private extension AppNavigationCoordinator {
    func navigate(to url: URL) {
        guard let components = URLComponents(url: url, resolvingAgainstBaseURL: false),
              let host = components.host else {
            Self.logger.warning("Deep link ignored: invalid URL components")
            return
        }

        Self.logger.debug("Deep link received: \(host, privacy: .public)")
    }

    func restorePath(from data: Data) {
        do {
            let decoder = JSONDecoder()
            decoder.dateDecodingStrategy = .iso8601
            let codableRep = try decoder.decode(
                NavigationPath.CodableRepresentation.self,
                from: data
            )
            appRouter.path = NavigationPath(codableRep)
            Self.logger.debug("Navigation state restored successfully")
        } catch {
            Self.logger.error("Failed to restore navigation state: \(error.localizedDescription, privacy: .public)")
        }
    }
}
