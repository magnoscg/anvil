import SwiftUI

// MARK: - CustomListRowModifier

/// ViewModifier for configuring List row appearance.
/// Removes separators, clears background, and allows custom insets.
struct CustomListRowModifier: ViewModifier {
    // MARK: - Properties

    let top: CGFloat
    let leading: CGFloat
    let bottom: CGFloat
    let trailing: CGFloat

    // MARK: - Body

    func body(content: Content) -> some View {
        content
            .listRowInsets(.init(top: top, leading: leading, bottom: bottom, trailing: trailing))
            .listRowSeparator(.hidden)
            .listRowBackground(Color.clear)
    }
}

// MARK: - View Extension

extension View {
    func customListRow(top: CGFloat = 0,
                       leading: CGFloat = 0,
                       bottom: CGFloat = 0,
                       trailing: CGFloat = 0) -> some View {
        modifier(CustomListRowModifier(top: top, leading: leading, bottom: bottom, trailing: trailing))
    }
}
