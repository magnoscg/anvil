import SwiftUI

// MARK: - AppTypography

/// Typography scale using Dynamic Type.
/// Never uses fixed font sizes. Maps to semantic names for consistent usage.
enum AppTypography {
    case largeTitle
    case title1
    case title2
    case title3
    case headline
    case body
    case callout
    case subheadline
    case footnote
    case caption1
    case caption2

    // MARK: - Font

    var font: Font {
        switch self {
        case .largeTitle:
            .largeTitle
        case .title1:
            .title
        case .title2:
            .title2
        case .title3:
            .title3
        case .headline:
            .headline
        case .body:
            .body
        case .callout:
            .callout
        case .subheadline:
            .subheadline
        case .footnote:
            .footnote
        case .caption1:
            .caption
        case .caption2:
            .caption2
        }
    }
}
