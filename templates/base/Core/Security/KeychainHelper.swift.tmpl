import Foundation
import Security

// MARK: - KeychainError

/// Typed errors for Keychain operations.
enum KeychainError: Error, Sendable {
    case itemNotFound
    case duplicateItem
    case encodingFailed
    case decodingFailed
    case unexpectedStatus(OSStatus)
}

// MARK: - KeychainAccessibility

/// When a Keychain item can be read. Both levels keep the item out of backups and off other devices.
enum KeychainAccessibility: Sendable {
    /// Readable only while the device is unlocked. The default: credentials used from the UI.
    case whenUnlocked
    /// Readable in the background after the first unlock. Only for items read by background work.
    case afterFirstUnlock

    var attributeValue: CFString {
        switch self {
        case .whenUnlocked:
            kSecAttrAccessibleWhenUnlockedThisDeviceOnly
        case .afterFirstUnlock:
            kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly
        }
    }
}

// MARK: - KeychainHelper

/// Generic-password Keychain wrapper using the Security framework directly.
/// Items are identified by `service` plus `key`; `service` defaults to the bundle identifier.
struct KeychainHelper: Sendable {
    // MARK: - Properties

    let service: String

    // MARK: - Init

    init(service: String = Bundle.main.bundleIdentifier ?? "{{ .BundleID }}") {
        self.service = service
    }

    // MARK: - Save

    /// Updates the item if it exists and adds it otherwise, keeping its metadata.
    func save(_ data: Data, for key: String, accessibility: KeychainAccessibility = .whenUnlocked) throws {
        let attributes: [String: Any] = [
            kSecValueData as String: data,
            kSecAttrAccessible as String: accessibility.attributeValue
        ]

        let updateStatus = SecItemUpdate(baseQuery(for: key) as CFDictionary, attributes as CFDictionary)
        switch updateStatus {
        case errSecSuccess:
            return
        case errSecItemNotFound:
            break
        default:
            throw KeychainError.unexpectedStatus(updateStatus)
        }

        let addQuery = baseQuery(for: key).merging(attributes) { _, new in new }
        let addStatus = SecItemAdd(addQuery as CFDictionary, nil)
        switch addStatus {
        case errSecSuccess:
            return
        case errSecDuplicateItem:
            throw KeychainError.duplicateItem
        default:
            throw KeychainError.unexpectedStatus(addStatus)
        }
    }

    // MARK: - Retrieve

    func retrieve(for key: String) throws -> Data {
        var query = baseQuery(for: key)
        query[kSecReturnData as String] = true
        query[kSecMatchLimit as String] = kSecMatchLimitOne

        var result: AnyObject?
        let status = SecItemCopyMatching(query as CFDictionary, &result)

        guard status == errSecSuccess, let data = result as? Data else {
            if status == errSecItemNotFound {
                throw KeychainError.itemNotFound
            }
            throw KeychainError.unexpectedStatus(status)
        }

        return data
    }

    // MARK: - Delete

    func delete(for key: String) throws {
        let status = SecItemDelete(baseQuery(for: key) as CFDictionary)
        guard status == errSecSuccess || status == errSecItemNotFound else {
            throw KeychainError.unexpectedStatus(status)
        }
    }

    // MARK: - Private

    private func baseQuery(for key: String) -> [String: Any] {
        [
            kSecClass as String: kSecClassGenericPassword,
            kSecAttrService as String: service,
            kSecAttrAccount as String: key
        ]
    }
}

// MARK: - Codable Convenience

extension KeychainHelper {
    func save<T: Encodable>(_ item: T, for key: String, accessibility: KeychainAccessibility = .whenUnlocked) throws {
        let data: Data
        do {
            data = try JSONEncoder().encode(item)
        } catch {
            throw KeychainError.encodingFailed
        }
        try save(data, for: key, accessibility: accessibility)
    }

    func read<T: Decodable>(for key: String) throws -> T {
        let data = try retrieve(for: key)
        do {
            return try JSONDecoder().decode(T.self, from: data)
        } catch {
            throw KeychainError.decodingFailed
        }
    }
}
