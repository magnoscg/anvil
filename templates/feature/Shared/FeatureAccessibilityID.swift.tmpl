import Foundation

// MARK: - {{ .FeatureName }}AccessibilityID

/// Accessibility identifiers for {{ .FeatureName }} UI elements.
/// Lives in Shared/, compiled into the app and the UI test target, so the View and the Page Object
/// read the same strings. There is no screen-wide id: SwiftUI hands a container's identifier to its
/// only child and overrides the child's own, so a state element marks the screen instead.
enum {{ .FeatureName }}AccessibilityID {
    // MARK: - States

    static let loadingIndicator = "{{ .FeatureNameSnake }}_loading"
    static let errorView = "{{ .FeatureNameSnake }}_error"
    static let retryButton = "{{ .FeatureNameSnake }}_retry_button"
    static let itemList = "{{ .FeatureNameSnake }}_item_list"

    // MARK: - Items

    static func itemRow(id: String) -> String {
        "{{ .FeatureNameSnake }}_item_\(id)"
    }
}
