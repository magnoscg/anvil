            {{ .FeatureName }}DTO(id: "2", name: "Second", description: "Second item"),
            {{ .FeatureName }}DTO(id: "3", name: "Third", description: "Third item")
        ]

        // When
        let models = sut.map(dtos)

        // Then
        #expect(models.count == 3)
