import Testing
import Foundation
@testable import {{ .ProjectName }}

@Suite("{{ .FeatureName }}UseCaseImpl Tests")
struct {{ .FeatureName }}UseCaseImplTests {
    // MARK: - Properties

    private var mockRepository: {{ .FeatureName }}RepositoryMock
    private var sut: {{ .FeatureName }}UseCaseImpl

    // MARK: - Setup

    init() {
        mockRepository = {{ .FeatureName }}RepositoryMock()
        sut = {{ .FeatureName }}UseCaseImpl(repository: mockRepository)
    }

    // MARK: - Success

    @Test("Given repository returns models, when execute, then returns the models")
    func execute_success_returnsModels() async throws {
        mockRepository.fetchResult = .success([
            {{ .FeatureName }}Model(id: "1", name: "First", description: "First item"),
            {{ .FeatureName }}Model(id: "2", name: "Second", description: "Second item")
        ])

        let result = try await sut.execute()

        #expect(result.map(\.id) == ["1", "2"])
        #expect(mockRepository.fetchCallCount == 1)
    }

    // MARK: - Error

    @Test("Given repository throws a DomainError, when execute, then propagates it")
    func execute_repositoryThrows_propagatesError() async {
        mockRepository.fetchResult = .failure(DomainError.network)

        await #expect(throws: DomainError.network) { try await sut.execute() }
        #expect(mockRepository.fetchCallCount == 1)
    }
}
