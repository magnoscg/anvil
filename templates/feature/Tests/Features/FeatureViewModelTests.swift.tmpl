import Testing
import Foundation
@testable import {{ .ProjectName }}

@MainActor
@Suite("{{ .FeatureName }}ViewModel Tests")
struct {{ .FeatureName }}ViewModelTests {
    // MARK: - Properties

    private var mockUseCase: {{ .FeatureName }}UseCaseMock
    private var mockDecoratorMapper: {{ .FeatureName }}DecoratorMapperMock
    private var mockRouter: {{ .FeatureName }}RouterMock
    private var sut: {{ .FeatureName }}ViewModel

    // MARK: - Setup

    init() {
        mockUseCase = {{ .FeatureName }}UseCaseMock()
        mockDecoratorMapper = {{ .FeatureName }}DecoratorMapperMock()
        mockRouter = {{ .FeatureName }}RouterMock()
        sut = {{ .FeatureName }}ViewModel(useCase: mockUseCase,
{{ "                                      " }}decoratorMapper: mockDecoratorMapper,
{{ "                                      " }}router: mockRouter)
    }

    // MARK: - Initial State

    @Test("Given new view model, then initial state is idle")
    func initialState_isIdle() {
        #expect(sut.state == .idle)
    }

    // MARK: - Success

    @Test("Given use case returns models, when load, then state is loaded")
    func load_success_setsLoadedState() async throws {
        mockUseCase.executeResult = .success([
            {{ .FeatureName }}Model(id: "1", name: "First", description: "First item")
        ])
        mockDecoratorMapper.mapResult = {{ .FeatureName }}Decorator(id: "1",
{{ "                                                                  " }}displayName: "First",
{{ "                                                                  " }}subtitle: "First item")

        await sut.load()

        let first = try #require(sut.items.first)
        #expect(sut.state == .loaded)
        #expect(sut.items.count == 1)
        #expect(first.id == "1")
        #expect(mockUseCase.executeCallCount == 1)
    }

    // MARK: - Error

    @Test("Given use case throws DomainError.network, when load, then state is the network error")
    func load_domainError_setsMappedErrorState() async {
        mockUseCase.executeResult = .failure(DomainError.network)

        await sut.load()

        #expect(sut.state == .error(.from(.network)))
        #expect(mockUseCase.executeCallCount == 1)
    }

    // MARK: - Cancellation

    @Test("Given a loaded screen, when a reload is cancelled, then the loaded state is kept")
    func load_cancelled_restoresPreviousState() async {
        mockUseCase.executeResult = .success([
            {{ .FeatureName }}Model(id: "1", name: "First", description: "First item")
        ])
        await sut.load()
        mockUseCase.executeResult = .failure(CancellationError())

        await sut.load()

        #expect(sut.state == .loaded)
        #expect(sut.items.count == 1)
        #expect(mockUseCase.executeCallCount == 2)
    }

    // MARK: - Navigation

    @Test("Given item id, when navigateToDetail, then router is called")
    func navigateToDetail_callsRouter() {
        sut.navigateToDetail(id: "test-id")

        #expect(mockRouter.navigateToDetailCallCount == 1)
        #expect(mockRouter.navigateToDetailId == "test-id")
    }
}
