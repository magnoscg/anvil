import SwiftUI

// MARK: - {{ .FeatureName }}RouteResolver

/// Resolves {{ .FeatureName }} routes inside the root NavigationStack
struct {{ .FeatureName }}RouteResolver: ViewModifier {
    // MARK: - Properties

    let appRouter: AppRouter
    let dependencies: AppDependencies

    // MARK: - Body

    func body(content: Content) -> some View {
        content
            .navigationDestination(for: {{ .FeatureName }}Route.self) { route in
                destination(for: route)
            }
    }

    // MARK: - Private Methods

    @ViewBuilder
    private func destination(for route: {{ .FeatureName }}Route) -> some View {
        switch route {
        case let .detail(id):
            // TODO: Replace with detail view
            // Example: {{ .FeatureName }}DetailView(id: id)
            Text("{{ .FeatureName }} Detail: \(id)")
        }
    }
}

// MARK: - View Extension

extension View {
    func with{{ .FeatureName }}Routes(appRouter: AppRouter, dependencies: AppDependencies) -> some View {
        modifier({{ .FeatureName }}RouteResolver(appRouter: appRouter, dependencies: dependencies))
    }
}
