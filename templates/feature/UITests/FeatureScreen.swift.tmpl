import XCTest

// MARK: - {{ .FeatureName }}Screen

/// Page Object for the {{ .FeatureName }} screen.
/// Encapsulates UI element queries and actions for readable UI tests.
@MainActor
struct {{ .FeatureName }}Screen {
    // MARK: - Properties

    private let app: XCUIApplication

    // MARK: - Init

    init(app: XCUIApplication) {
        self.app = app
    }

    // MARK: - Launch

    /// Launches the app with this screen as the root view.
    /// `fixture` is a scenario of `Fixture{{ .FeatureName }}RemoteDataSource`: "default", "empty" or "error".
    static func launch(fixture: String? = nil) -> {{ .FeatureName }}Screen {
        {{ .FeatureName }}Screen(app: .launchForUITesting(screen: "{{ .FeatureName }}", fixture: fixture))
    }

    // MARK: - Elements

    /// The element of whichever state the screen shows: loading, items or error.
    var screenElement: XCUIElement {
        let stateIDs = [
            {{ .FeatureName }}AccessibilityID.loadingIndicator,
            {{ .FeatureName }}AccessibilityID.itemList,
            {{ .FeatureName }}AccessibilityID.errorView,
        ]
        return app.descendants(matching: .any)
            .matching(NSPredicate(format: "identifier IN %@", stateIDs))
            .firstMatch
    }

    var loadingIndicator: XCUIElement {
        app.activityIndicators[{{ .FeatureName }}AccessibilityID.loadingIndicator]
    }

    var errorView: XCUIElement {
        app.otherElements[{{ .FeatureName }}AccessibilityID.errorView]
    }

    var retryButton: XCUIElement {
        app.buttons[{{ .FeatureName }}AccessibilityID.retryButton]
    }

    var itemList: XCUIElement {
        app.scrollViews[{{ .FeatureName }}AccessibilityID.itemList]
    }

    func item(id: String) -> XCUIElement {
        app.buttons[{{ .FeatureName }}AccessibilityID.itemRow(id: id)]
    }

    // MARK: - Queries

    var isLoaded: Bool {
        screenElement.exists
    }

    var hasItems: Bool {
        itemList.exists
    }

    var isShowingError: Bool {
        errorView.exists
    }

    // MARK: - Actions

    func waitForScreen(timeout: TimeInterval = 5) {
        _ = screenElement.waitForExistence(timeout: timeout)
    }

    func waitForItems(timeout: TimeInterval = 10) {
        _ = itemList.waitForExistence(timeout: timeout)
    }

    func waitForError(timeout: TimeInterval = 10) {
        _ = errorView.waitForExistence(timeout: timeout)
    }

    func tapItem(id: String) {
        item(id: id).tap()
    }

    func tapRetry() {
        retryButton.tap()
    }
}
