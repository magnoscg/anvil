import XCTest

// MARK: - {{ .FeatureName }}ScreenTests

/// UI tests for the {{ .FeatureName }} screen.
/// Uses Page Object pattern via {{ .FeatureName }}Screen for readable, maintainable tests.
final class {{ .FeatureName }}ScreenTests: XCTestCase {
    // MARK: - Properties

    private var app: XCUIApplication!
    private var screen: {{ .FeatureName }}Screen!

    // MARK: - Setup

    override func setUpWithError() throws {
        continueAfterFailure = false
        app = XCUIApplication()
        app.launchArguments = ["--uitesting"]
        app.launch()
        screen = {{ .FeatureName }}Screen(app: app)
    }

    override func tearDownWithError() throws {
        app = nil
        screen = nil
    }

    // MARK: - Tests

    func testScreenLoadsSuccessfully() {
        screen.waitForScreen()
        XCTAssertTrue(screen.isLoaded, "{{ .FeatureName }} screen should be loaded")
    }

    func testItemListDisplaysItems() {
        screen.waitForScreen()
        screen.waitForItems()
        XCTAssertTrue(screen.hasItems, "Item list should display items")
    }
}
