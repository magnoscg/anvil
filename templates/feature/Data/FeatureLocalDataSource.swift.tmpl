import Foundation

// MARK: - {{ .FeatureName }}LocalDataSource

/// Protocol for local {{ .FeatureNameLower }} data persistence using UserDefaults
protocol {{ .FeatureName }}LocalDataSource: Sendable {
    func save(_ items: [{{ .FeatureName }}DTO]) throws
    func load() throws -> [{{ .FeatureName }}DTO]
    func clear()
}

// MARK: - {{ .FeatureName }}LocalDataSourceImpl

/// Implementation of {{ .FeatureName }}LocalDataSource using UserDefaults
struct {{ .FeatureName }}LocalDataSourceImpl: {{ .FeatureName }}LocalDataSource {
    // MARK: - Properties

    private let defaults: UserDefaults
    private let key = "{{ .FeatureNameSnake }}_cache"

    // MARK: - Init

    init(defaults: UserDefaults = .standard) {
        self.defaults = defaults
    }

    // MARK: - Public Methods

    func save(_ items: [{{ .FeatureName }}DTO]) throws {
        let data = try JSONEncoder().encode(items)
        defaults.set(data, forKey: key)
    }

    func load() throws -> [{{ .FeatureName }}DTO] {
        guard let data = defaults.data(forKey: key) else { return [] }
        return try JSONDecoder().decode([{{ .FeatureName }}DTO].self, from: data)
    }

    func clear() {
        defaults.removeObject(forKey: key)
    }
}
