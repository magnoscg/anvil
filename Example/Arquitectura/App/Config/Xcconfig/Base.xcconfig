// Base.xcconfig
// Base configuration shared across all environments

// MARK: - API Configuration

API_VERSION = v1
REQUEST_TIMEOUT = 30

// MARK: - App Configuration

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// MARK: - App Setup
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Arquitectura/Info.plist
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES

// MARK: - Resource Symbol Generation

// Assets: Generates static accessors like Color.accentColor or Image.logo
ASSET_CATALOG_COMPILER_GENERATE_ASSET_SYMBOLS = YES
ASSET_CATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES

// Localization: Generates symbols for String Catalog (.xcstrings)
LOCALIZED_STRING_SWIFT_SYMBOLS_GENERATION = YES
